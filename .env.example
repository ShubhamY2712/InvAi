# Copy to .env and fill in real values. .env is git-ignored; this file is committed, so never put secrets here.

# Postgres connection used by the app, Alembic and the scripts (scripts/reset_db.py only runs against localhost).
DATABASE_URL=postgresql://invai:change-me@localhost:5432/invai

# Signs login tokens; the app refuses to start without it. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Comma-separated browser origins allowed to call the API (no "*"); leave empty to allow no cross-origin requests.
CORS_ORIGINS=http://localhost:3000
